.DS_Store
*.log

# Go
bin/

# Node
node_modules/
dist/

# `wails3 generate bindings` stages into a temp directory beside the frontend
# and swaps it into desktop/frontend/bindings/. An interrupted run leaves one
# behind, and it is 68 files a `git add -A` will take.
desktop/frontend/.bindings-tmp-*/

# web/: the Zensical build and cache, the uv virtualenv, wrangler local dev state
web/site/
web/.cache/
.venv/
.wrangler/

# Local env
.env
launch.env
launch.onboarding.env
overrides.env
.data/
.hive-desktop/
.hive-desktop-onboarding/
.hive-desktop.lock/
.hive-desktop.lock.stale.*/
.hive-desktop-onboarding.lock/
.hive-desktop-onboarding.lock.stale.*/

# Binaries `go build ./cmd/<name>` drops in the repo root. Keep this above the
# negation below, which has to stay last.
/adr
/devserver
/devtools
/release
/vendorhive

# Vendored embed assets (internal/hivecore/hive/scripts/bin) must stay tracked:
# go:embed needs them in every fresh checkout, including the e2e Docker build
# and release builds that never run vendorhive. Directory-only negation so junk
# files under the vendored tree stay ignored. Keep this rule last — later
# ignore rules would override it.
!internal/hivecore/**/bin/
