{
  // Landing page for hivedesktop.com. The Astro build in ./dist is served as
  // Worker static assets; worker/index.ts handles /api/latest and
  // /api/subscribe and falls through to the assets for everything else.
  "name": "hive-desktop-web",
  "account_id": "bce6b95e4e84d92b1972d3b55b6cfaf6",
  "compatibility_date": "2026-07-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [{ "pattern": "hivedesktop.com", "custom_domain": true }],
  // Private diagnostics bucket for /api/report. No public access, no custom
  // domain — the binding is the only writer. REPORT_TOKEN is a secret set with
  // `wrangler secret put`, never committed here.
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "hive-desktop-reports" }]
}
