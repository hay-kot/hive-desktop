---
import { pipeline } from "../data";
import Icon from "./Icon.astro";
import Lines from "./Lines.astro";
import PipelineDiagram from "./PipelineDiagram.astro";

const cards = [pipeline.sourcesCard, pipeline.nodesCard];
---

<section class="pipeline shell" id="flow">
  <div class="pipeline__head" data-reveal>
    <div class="eyebrow">{pipeline.eyebrow}</div>
    <h2 class="pipeline__title"><Lines lines={pipeline.titleLines} /></h2>
    <p class="pipeline__body">{pipeline.body}</p>
  </div>

  <div data-reveal>
    <PipelineDiagram />
  </div>

  <div class="cards" data-reveal>
    {
      cards.map((card) => (
        <div class="card">
          <div class="card__head">
            <span class="card__label mono" style={`color:var(--${card.accent})`}>
              {card.label}
            </span>
            <span class="card__hint">{card.hint}</span>
          </div>
          <div class="card__grid">
            {card.items.map((item) => (
              <div
                class:list={["entry", item.wide && "entry--wide", item.dashed && "entry--dashed"]}
              >
                <span class="entry__icon" data-icon={item.icon}>
                  <Icon name={item.icon} size={15} />
                </span>
                <div class="entry__body">
                  <div class="entry__title">{item.title}</div>
                  <div class="entry__meta mono">{item.meta}</div>
                </div>
                {item.tag && (
                  <span
                    class="tag"
                    style={`color:var(--${item.tagAccent ?? "green"});background:var(--${item.tagAccent ?? "green"}-tint)`}
                  >
                    {item.tag}
                  </span>
                )}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .pipeline {
    padding-block: 100px 64px;
  }

  .pipeline__head {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 48px;
  }

  .pipeline__title {
    margin-top: 16px;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .pipeline__body {
    margin-top: 18px;
    font-size: 16.5px;
    color: var(--text-muted);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .cards {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 18px;
  }

  .card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    padding: 20px 20px 22px;
  }

  .card__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 16px;
  }

  .card__label {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .card__hint {
    font-size: 12px;
    color: #7c828d;
  }

  .card__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 10px;
  }

  .entry {
    display: flex;
    align-items: center;
    gap: 11px;
    background: var(--panel-2);
    border: 1px solid var(--line-diagram);
    border-radius: 11px;
    padding: 10px 12px;
  }

  .entry--wide {
    grid-column: 1 / -1;
  }

  .entry--dashed {
    border-style: dashed;
    border-color: #3a3f4a;
  }

  .entry__icon {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: #0e1116;
    border: 1px solid var(--line-diagram);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    color: var(--text-dim);
  }

  .entry--dashed .entry__icon {
    border-color: #3a2f18;
  }

  /* Brand and node colours for the marks that carry one. */
  .entry__icon[data-icon="grafana"],
  .entry__icon[data-icon="bolt"] {
    color: var(--amber);
  }

  .entry__icon[data-icon="posthog"] {
    color: #f9bd2b;
  }

  .entry__icon[data-icon="filter"],
  .entry__icon[data-icon="braces"] {
    color: var(--green-2);
  }

  .entry__icon[data-icon="router"] {
    color: var(--violet);
  }

  .entry__icon[data-icon="sparkle"],
  .entry__icon[data-icon="feed"] {
    color: var(--green);
  }

  .entry__icon[data-icon="command"] {
    color: var(--blue);
  }

  .entry__body {
    min-width: 0;
    flex: 1;
  }

  .entry__title {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-diagram);
  }

  .entry__meta {
    font-size: 10.5px;
    color: #7c828d;
  }

  @media (max-width: 720px) {
    .pipeline {
      padding-block: 64px 40px;
    }
  }
</style>
