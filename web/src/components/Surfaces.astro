---
import { surfaces as data } from "../data";
import Icon from "./Icon.astro";
---

<section class="surfaces shell" id="surfaces">
  <div class="surfaces__head" data-reveal>
    <div class="surfaces__lead">
      <div class="eyebrow">{data.eyebrow}</div>
      <h2 class="surfaces__title">{data.title}</h2>
    </div>
    <p class="surfaces__intro">{data.intro}</p>
  </div>

  <div class="surfaces__grid" data-reveal>
    {
      data.surfaces.map((surface) => (
        <article class="surface">
          <header class="surface__head">
            <span
              class="surface__icon"
              style={`color:var(--${surface.accent});background:var(--${surface.accent}-tint);border-color:var(--${surface.accent}-edge)`}
              aria-hidden="true"
            >
              <Icon name={surface.icon} size={16} />
            </span>
            <h3 class="surface__name">{surface.name}</h3>
            <span
              class="surface__status mono"
              style={`color:var(--${surface.statusAccent});background:var(--${surface.statusAccent}-tint);border-color:var(--${surface.statusAccent}-edge)`}
            >
              {surface.status}
            </span>
          </header>

          <p class="surface__tagline">{surface.tagline}</p>
          <p class="surface__body">{surface.body}</p>

          <ul class="surface__points">
            {surface.points.map((point) => (
              <li class="surface__point">{point}</li>
            ))}
          </ul>

          <div class="surface__note mono">{surface.note}</div>
        </article>
      ))
    }
  </div>

  <p class="surfaces__footnote" data-reveal>{data.footnote}</p>
</section>

<style>
  .surfaces {
    padding-block: 80px 24px;
  }

  .surfaces__head {
    display: flex;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .surfaces__title {
    margin-top: 10px;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .surfaces__intro {
    flex: 1 1 360px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .surfaces__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  @media (max-width: 900px) {
    .surfaces__grid {
      grid-template-columns: 1fr;
    }
  }

  .surface {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 26px 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .surface__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .surface__icon {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    border: 1px solid transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .surface__name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .surface__status {
    margin-left: auto;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .surface__tagline {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .surface__body {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .surface__points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 2px;
  }

  .surface__point {
    position: relative;
    padding-left: 16px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .surface__point::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--line-2);
  }

  .surface__note {
    font-size: 11px;
    color: var(--text-ghost);
    border-top: 1px solid var(--line-3);
    padding-top: 12px;
    margin-top: auto;
  }

  .surfaces__footnote {
    margin-top: 22px;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--text-dim);
    max-width: 720px;
    text-wrap: pretty;
  }

  @media (max-width: 720px) {
    .surfaces {
      padding-block: 40px 16px;
    }
  }
</style>
