---
import { preview } from "../data";
import Icon from "./Icon.astro";

const { titlebar, spaces, sidebar, search, tabs, view, items, detail } = preview;
---

<!-- Decorative product illustration: hidden from assistive tech so the fake UI
     is not announced as if it were real. Mirrors the app's default dark theme
     (see --hv-* tokens in desktop/frontend/src/styles/main.css). -->
<div class="frame" aria-hidden="true">
  <div class="frame__glow"></div>

  <div class="window">
    <!-- Title bar: three equal columns so the command box sits dead centre,
         the way the app does it. -->
    <div class="titlebar">
      <div class="titlebar__col titlebar__col--left">
        <div class="lights"><span></span><span></span><span></span></div>
        <span class="iconbtn"><Icon name="panel-left" size={14} /></span>
      </div>

      <div class="titlebar__col titlebar__col--center">
        <span class="iconbtn"><Icon name="arrow-left" size={14} /></span>
        <span class="iconbtn"><Icon name="arrow-right" size={14} /></span>
        <div class="command">
          <Icon name="search" size={13} />
          <span class="command__text">{titlebar.command}</span>
          <span class="command__key mono">{titlebar.shortcut}</span>
        </div>
      </div>

      <div class="titlebar__col titlebar__col--right">
        <span class="chip">
          <Icon name="activity" size={13} />
          {titlebar.activity}
          <span class="chip__dot"></span>
        </span>
        <span class="iconbtn"><Icon name="panel-right" size={14} /></span>
      </div>
    </div>

    <div class="body">
      <!-- Profile rail -->
      <div class="rail">
        {
          spaces.map((space) => (
            <div class:list={["rail__tile", "mono", space.active && "is-active"]}>
              {space.active && <span class="rail__marker" />}
              {space.initials}
            </div>
          ))
        }
        <div class="rail__add"><Icon name="plus" size={15} /></div>
        <div class="rail__spacer"></div>
        <div class="rail__gear"><Icon name="settings" size={15} /></div>
      </div>

      <!-- Sidebar -->
      <div class="sidebar">
        <div class="sidebar__head">
          <div class="sidebar__titlerow">
            <span class="sidebar__title">{sidebar.title}</span>
            <span class="sidebar__gear"><Icon name="settings" size={13} /></span>
          </div>
          <div class="sidebar__sources">
            <span class="sourcechip"><Icon name="git-branch" size={9} /></span>
            {sidebar.sources}
          </div>
        </div>

        <div class="sidebar__scroll">
        <div class="sidebar__block">
          <div class="row row--active">
            <span class="navicon navicon--accent"><Icon name="list" size={11} /></span>
            <span class="row__label">{sidebar.views.inbox.label}</span>
            <span class="row__count mono is-hot">{sidebar.views.inbox.count}</span>
          </div>

          <div class="row">
            <span class="navicon"><Icon name="folder" size={11} /></span>
            <span class="row__label row__label--folder">{sidebar.views.moreLabel}</span>
            <span class="row__chevron">
              <Icon name={sidebar.views.moreCollapsed ? "chevron-right" : "chevron-down"} size={12} />
            </span>
          </div>

          {
            !sidebar.views.moreCollapsed && (
              <div class="children">
                {sidebar.views.more.map((label) => (
                  <div class="row">
                    <span class="navicon">
                      <Icon name="list" size={11} />
                    </span>
                    <span class="row__label">{label}</span>
                  </div>
                ))}
              </div>
            )
          }
        </div>

        <div class="sidebar__block">
          <div class="grouplabel mono">
            <Icon name="rss" size={11} />
            {sidebar.feedsLabel}
          </div>

          {
            sidebar.feeds.map((entry) =>
              entry.folder ? (
                <>
                  <div class="row">
                    <span class="navicon"><Icon name="folder" size={11} /></span>
                    <span class="row__label row__label--folder">{entry.label}</span>
                    <span class="row__count mono is-hot">{entry.count}</span>
                  </div>
                  <div class="children">
                    {entry.children?.map((child) => (
                      <div class:list={["row", child.selected && "row--selected"]}>
                        <span class:list={["navicon", child.selected && "navicon--accent"]}>
                          <Icon name={child.icon ?? "list"} size={11} />
                        </span>
                        <span class="row__label">{child.label}</span>
                        <span class:list={["row__count", "mono", Number(child.count) > 0 && "is-hot"]}>
                          {child.count}
                        </span>
                      </div>
                    ))}
                  </div>
                </>
              ) : (
                <div class="row">
                  <span class="navicon"><Icon name={entry.icon ?? "list"} size={11} /></span>
                  <span class="row__label">{entry.label}</span>
                  <span class="row__count mono">{entry.count}</span>
                </div>
              ),
            )
          }
        </div>
        </div>

        <div class="sidebar__footer">
          <span class="footer__tile"><Icon name="workflow" size={12} /></span>
          <div class="footer__body">
            <div class="footer__title">{sidebar.footer.title}</div>
            <div class="footer__sub mono">{sidebar.footer.subtitle}</div>
          </div>
          <span class="footer__chevron"><Icon name="chevron-right" size={13} /></span>
        </div>
      </div>

      <!-- Item list -->
      <div class="list">
        <div class="list__head">
          <div class="search">
            <Icon name="search" size={13} />
            <span class="search__placeholder">{search.placeholder}</span>
          </div>
          <div class="tabs">
            <span class="tabs__tab is-active">{tabs.all}</span>
            <span class="tabs__tab">
              {tabs.unread}
              <span class="tabs__count mono">{tabs.unreadCount}</span>
            </span>
          </div>
          <div class="viewbtn">
            <Icon name="sliders" size={13} />
            {view}
            <Icon name="chevron-down" size={12} />
          </div>
        </div>

        <div class="list__items">
          {
            items.map((item) => (
              <div class:list={["item", item.selected && "is-selected"]}>
                <span class="item__badge">
                  <Icon name="github" size={15} />
                </span>
                <div class="item__body">
                  <div class="item__top">
                    <div class="item__title">{item.title}</div>
                    <span class="item__dot"></span>
                    <span class="item__age mono">{item.age}</span>
                  </div>
                  <div class="item__meta">
                    <span
                      class="kind mono"
                      style={`color:var(--kind-${item.accent});background:var(--kind-${item.accent}-tint)`}
                    >
                      {item.type}
                    </span>
                    <span class="item__context mono">{item.context}</span>
                  </div>
                  <div class="item__snippet">{item.snippet}</div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Detail pane -->
      <div class="detail">
        <div class="detail__head">
          <div class="detail__chips">
            <span class="detail__badge"><Icon name="github" size={14} /></span>
            <span
              class="kind kind--lg mono"
              style={`color:var(--kind-${detail.accent});background:var(--kind-${detail.accent}-tint)`}
            >
              <Icon name="issue" size={11} />
              {detail.type}
            </span>
            <span class="detail__context mono">{detail.context}</span>
            <span class="detail__open mono">
              {detail.open}
              <Icon name="external-link" size={10} />
            </span>
          </div>
          <div class="detail__title">{detail.title}</div>
          <div class="detail__byline mono">{detail.byline}</div>
        </div>

        <div class="detail__actions">
          <div class="detail__label">
            <span class="mono detail__labeltext">{detail.actionsLabel}</span>
            <span class="mono detail__labelfor">{detail.actionsFor}</span>
            <span class="detail__edit mono">{detail.edit}</span>
          </div>

          {
            detail.actions.map((action) => (
              <div class="action">
                <span
                  class="action__icon"
                  style={`color:var(--${action.accent});border-color:var(--${action.accent})`}
                >
                  {action.icon}
                </span>
                <div class="action__body">
                  <div class="action__title">{action.title}</div>
                  <div class="action__meta mono">{action.meta}</div>
                </div>
                {action.run && <span class="action__run">{action.run} ↵</span>}
              </div>
            ))
          }

          <div class="detail__footnote mono">{detail.footnote}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .frame {
    position: relative;
    width: 100%;
    margin-top: 56px;
  }

  .frame__glow {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 70%;
    height: 70%;
    background: radial-gradient(ellipse at center, rgba(245, 158, 11, 0.32), transparent 70%);
    filter: blur(60px);
    transform: translate(-50%, -50%);
    animation: hiveGlow 6s ease-in-out infinite;
    pointer-events: none;
  }

  .window {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 13px;
    overflow: hidden;
    box-shadow: 0 40px 90px -30px rgba(28, 28, 26, 0.5);
    text-align: left;
  }

  /* title bar ----------------------------------------------------------- */

  .titlebar {
    height: 42px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line-2);
    color: var(--text-muted);
  }

  .titlebar__col {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .titlebar__col--center {
    justify-content: center;
  }

  .titlebar__col--right {
    justify-content: flex-end;
  }

  .lights {
    display: flex;
    gap: 7px;
    margin-right: 6px;
  }

  .lights span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .lights span:nth-child(1) {
    background: #ff5f57;
  }

  .lights span:nth-child(2) {
    background: #febc2e;
  }

  .lights span:nth-child(3) {
    background: #28c840;
  }

  .iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 5px;
    color: var(--text-faint);
    flex: none;
  }

  .command {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 27px;
    flex: 1;
    max-width: 340px;
    min-width: 0;
    background: var(--bg);
    border: 1px solid var(--line-2);
    border-radius: 6px;
    padding: 0 9px;
    color: var(--text-faint);
  }

  .command__text {
    font-size: 12.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .command__key {
    margin-left: auto;
    font-size: 10.5px;
    border: 1px solid var(--line-2);
    border-radius: 4px;
    padding: 0 5px;
    flex: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--text-muted);
    border: 1px solid var(--line-2);
    border-radius: 6px;
    padding: 4px 9px;
    white-space: nowrap;
  }

  .chip__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
    animation: hivePulse 2.4s ease-in-out infinite;
  }

  /* layout -------------------------------------------------------------- */

  .body {
    display: flex;
    height: 520px;
    color: var(--text-bright);
  }

  /* rail ---------------------------------------------------------------- */

  .rail {
    width: 58px;
    flex: none;
    background: var(--surface-2);
    border-right: 1px solid var(--line-2);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px 0;
    gap: 10px;
  }

  .rail__tile,
  .rail__add,
  .rail__gear {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    font-size: 14px;
    font-weight: 600;
    background: #2f313b;
    color: var(--text-muted);
    border: 1px solid var(--line);
  }

  .rail__tile.is-active {
    position: relative;
    background: var(--line-2);
    color: var(--text-bright);
  }

  .rail__marker {
    position: absolute;
    left: -13px;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: 2px;
    background: var(--amber);
  }

  .rail__add {
    background: none;
    border: 1px dashed var(--line);
    color: var(--text-fainter);
  }

  .rail__gear {
    background: none;
    border: none;
    color: var(--text-faint);
  }

  .rail__spacer {
    flex: 1;
  }

  /* sidebar ------------------------------------------------------------- */

  .sidebar {
    width: 250px;
    flex: none;
    background: var(--surface-3);
    border-right: 1px solid var(--line-2);
    display: flex;
    flex-direction: column;
  }

  .sidebar__head {
    padding: 16px 16px 12px;
    border-bottom: 1px solid var(--line-2);
  }

  .sidebar__titlerow {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sidebar__title {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    flex: 1;
    min-width: 0;
  }

  .sidebar__gear {
    color: var(--text-faint);
    display: inline-flex;
  }

  .sidebar__sources {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 7px;
    font-size: 12px;
    color: var(--text-faint);
  }

  .sourcechip {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1px solid var(--line);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  /* Feeds scroll; the flow footer stays pinned to the bottom the way the
     app keeps it reachable no matter how many feeds you have. */
  .sidebar__scroll {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .sidebar__block {
    padding: 10px;
  }

  .sidebar__block + .sidebar__block {
    padding-top: 2px;
  }

  .grouplabel {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 6px 7px;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--text-fainter);
  }

  .grouplabel :global(svg) {
    color: var(--green);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 8px;
    border-radius: 7px;
    color: var(--text-muted);
    font-size: 13px;
  }

  .row--active,
  .row--selected {
    background: var(--line-2);
    color: var(--amber);
    font-weight: 500;
  }

  .navicon {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid #484b57;
    background: var(--bg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    color: var(--text-faint);
  }

  .navicon--accent {
    border-color: #3a2f18;
    color: var(--amber);
  }

  .row__label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row__label--folder {
    font-weight: 500;
  }

  .row__count {
    font-size: 11px;
    color: var(--text-faint);
    flex: none;
  }

  .row__count.is-hot {
    color: var(--amber);
  }

  .row__chevron,
  .footer__chevron {
    display: inline-flex;
    color: var(--text-fainter);
    flex: none;
  }

  .children {
    padding-left: 12px;
  }

  .sidebar__footer {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-top: 1px solid var(--line-2);
  }

  .footer__tile {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: 1px dashed var(--line);
    background: var(--bg);
    color: var(--amber);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .footer__body {
    flex: 1;
    min-width: 0;
  }

  .footer__title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text);
  }

  .footer__sub {
    font-size: 11px;
    color: var(--text-faint);
  }

  /* list ---------------------------------------------------------------- */

  .list {
    flex: 1.25;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-right: 1px solid var(--line-2);
    background: var(--surface);
  }

  .list__head {
    flex: none;
    height: 46px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border-bottom: 1px solid var(--line-2);
    background: var(--panel);
  }

  .search {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg);
    border: 1px solid #484b57;
    border-radius: 8px;
    padding: 6px 11px;
    color: var(--text-faint);
  }

  .search__placeholder {
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tabs {
    display: flex;
    align-items: center;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 2px;
    flex: none;
  }

  .tabs__tab {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    padding: 4px 11px;
    border-radius: 6px;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .tabs__tab.is-active {
    background: var(--amber);
    color: var(--ink);
  }

  .tabs__count {
    font-size: 10px;
    opacity: 0.85;
  }

  .viewbtn {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 9px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    flex: none;
  }

  .list__items {
    flex: 1;
    overflow: hidden;
  }

  .item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 13px 16px 13px 18px;
    border-bottom: 1px solid var(--line-3);
  }

  .item.is-selected {
    background: rgba(245, 158, 11, 0.1);
  }

  .item__badge {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    background: #2f313b;
    border: 1px solid #484b57;
    color: #e6edf3;
  }

  .item__body {
    flex: 1;
    min-width: 0;
  }

  .item__top {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .item__title {
    flex: 1;
    min-width: 0;
    font-size: 13.5px;
    line-height: 1.35;
    font-weight: 600;
    color: var(--text-bright);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .item__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
    flex: none;
  }

  .item__age {
    font-size: 11px;
    color: var(--text-fainter);
    flex: none;
  }

  .item__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 5px;
    min-width: 0;
  }

  .kind {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.02em;
    border-radius: 4px;
    padding: 2px 7px;
    flex: none;
  }

  .kind--lg {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 6px;
  }

  .item__context {
    font-size: 11px;
    color: var(--text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .item__snippet {
    margin-top: 5px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* detail -------------------------------------------------------------- */

  .detail {
    width: 330px;
    flex: none;
    background: var(--panel);
    display: flex;
    flex-direction: column;
  }

  .detail__head {
    padding: 18px 18px 16px;
    border-bottom: 1px solid var(--line-2);
  }

  .detail__chips {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    min-width: 0;
  }

  .detail__badge {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: #2f313b;
    border: 1px solid #484b57;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    color: #e6edf3;
  }

  .detail__context {
    font-size: 11px;
    color: var(--text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .detail__open {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: var(--text-muted);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px 8px;
    flex: none;
  }

  .detail__title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .detail__byline {
    margin-top: 9px;
    font-size: 12px;
    color: var(--text-faint);
  }

  .detail__actions {
    padding: 16px 18px;
  }

  .detail__label {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
  }

  .detail__labeltext {
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--amber);
  }

  .detail__labelfor {
    font-size: 10.5px;
    color: var(--text-fainter);
  }

  .detail__edit {
    margin-left: auto;
