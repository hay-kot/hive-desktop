---
import { features } from "../data";
---

<section class="features shell" id="features">
  <h2 class="sr-only">Features</h2>
  <div class="features__grid">
    {
      features.map((feature) => (
        <article class="feature" data-reveal>
          <span
            class="feature__icon"
            style={`color:var(--${feature.accent});background:var(--${feature.accent}-tint);border-color:var(--${feature.accent}-edge)`}
            aria-hidden="true"
          >
            {feature.icon}
          </span>
          <h3 class="feature__title">{feature.title}</h3>
          <p class="feature__body">{feature.body}</p>
          <div class="feature__meta mono">{feature.meta}</div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .features {
    padding-block: 80px 24px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Six cards: 3-up, then 2-up, then stacked. Every step divides evenly, so
     no row is ever left with a hole in it. */
  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  @media (max-width: 980px) {
    .features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .features__grid {
      grid-template-columns: 1fr;
    }
  }

  .feature {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 30px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .feature:hover {
    transform: translateY(-4px);
    border-color: #565863;
    box-shadow: 0 24px 50px -28px rgba(28, 28, 26, 0.55);
  }

  .feature__icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex: none;
  }

  .feature__title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .feature__body {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .feature__meta {
    font-size: 11px;
    color: var(--text-ghost);
    border-top: 1px solid var(--line-3);
    padding-top: 12px;
    margin-top: auto;
  }

  @media (max-width: 720px) {
    .features {
      padding-block: 40px 16px;
    }
  }
</style>
