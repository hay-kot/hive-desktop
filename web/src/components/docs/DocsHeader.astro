---
import { site } from "../../data";
import Icon from "../Icon.astro";
import DocsSearch from "./DocsSearch.astro";

const links = [
  { label: "Features", href: "/#features" },
  { label: "Compare", href: "/compare" },
  { label: "GitHub", href: "https://github.com/hay-kot/hive-desktop" },
];
---

<header class="docshead">
  <div class="docshead__inner">
    <a class="docshead__brand" href="/">
      <Icon name="hex" size={20} />
      <span>{site.brand.name}</span>
      <span class="docshead__tag">docs</span>
    </a>

    <nav class="docshead__links" aria-label="Site">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="docshead__actions">
      <DocsSearch />
      <a class="docshead__cta" href="/install">Install</a>
    </div>
  </div>
</header>
