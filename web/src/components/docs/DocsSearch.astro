---
// Static search over the docs, powered by Pagefind. The index lives at
// /pagefind/, generated by the `pagefind` step in `npm run build`. It does not
// exist under `astro dev`, so the modal degrades to a build-it message there.
---

<button class="docsearch-btn" id="docsearch-open" aria-label="Search docs" aria-keyshortcuts="/">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
    <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  <span>Search</span>
  <kbd>/</kbd>
</button>

<dialog class="docsearch" id="docsearch" aria-label="Search documentation">
  <div class="docsearch__panel">
    <div id="docsearch-ui"></div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("docsearch") as HTMLDialogElement | null;
  const openBtn = document.getElementById("docsearch-open");
  const mount = document.getElementById("docsearch-ui");
  let loaded = false;

  function loadScript(src: string) {
    return new Promise<void>((resolve, reject) => {
      const s = document.createElement("script");
      s.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`failed to load ${src}`));
      document.head.appendChild(s);
    });
  }

  async function ensureLoaded() {
    if (loaded || !mount) return;
    loaded = true;
    const css = document.createElement("link");
    css.rel = "stylesheet";
    css.href = "/pagefind/pagefind-ui.css";
    document.head.appendChild(css);
    try {
      await loadScript("/pagefind/pagefind-ui.js");
      new (window as any).PagefindUI({
        element: "#docsearch-ui",
        showSubResults: true,
        showImages: false,
      });
    } catch {
      mount.innerHTML =
        '<p class="docsearch__err">Search is generated at build time and is not available in this dev preview. Run <code>npm run build</code> to index the docs.</p>';
    }
  }

  function open() {
    if (!dialog) return;
    ensureLoaded();
    if (!dialog.open) dialog.showModal();
    window.setTimeout(() => dialog.querySelector("input")?.focus(), 40);
  }

  function typingTarget(el: EventTarget | null) {
    const node = el as HTMLElement | null;
    if (!node) return false;
    const tag = node.tagName;
    return tag === "INPUT" || tag === "TEXTAREA" || node.isContentEditable;
  }

  openBtn?.addEventListener("click", open);

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      open();
      return;
    }
    if (e.key === "/" && !typingTarget(e.target) && !dialog?.open) {
      e.preventDefault();
      open();
    }
  });

  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
