---
import { docHref, type DocsTree } from "../../lib/docs";

interface Props {
  tree: DocsTree;
  currentId: string;
}

const { tree, currentId } = Astro.props;
---

<details class="docsnav" open>
  <summary class="docsnav__summary">Documentation</summary>
  <div class="docsnav__body">
    {
      tree.map((group) => (
        <div class="docsnav__group">
          <p class="docsnav__title">{group.group}</p>
          <ul>
            {group.entries.map((entry) => (
              <li>
                <a
                  href={docHref(entry)}
                  class:list={["docsnav__link", entry.id === currentId && "is-active"]}
                  aria-current={entry.id === currentId ? "page" : undefined}
                >
                  {entry.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</details>
