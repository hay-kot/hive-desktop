---
/**
 * The beta signup form plus its success state. Rendered twice on the landing
 * page (the beta section and the request-access dialog), so the script scopes
 * every lookup to its own [data-signup] root.
 */
import { beta } from "../data";
import Icon from "./Icon.astro";
---

<div class="signup" data-signup>
  <form
    class="form"
    data-subscribe
    data-endpoint={beta.form.endpoint}
    data-errors={JSON.stringify(beta.errors)}
    novalidate
  >
    <div class="form__label mono">{beta.form.label}</div>

    <label class="field">
      <span class="field__icon"><Icon name="mail" size={16} /></span>
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder={beta.form.placeholder}
        aria-label={beta.form.label}
      />
    </label>

    <!-- Honeypot: never shown to people, so anything here is a bot. -->
    <div class="trap" aria-hidden="true">
      <label>
        Company
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <button type="submit" class="form__submit">
      <span data-submit-label>{beta.form.submit}</span>
      <span aria-hidden="true">→</span>
    </button>

    <p class="form__error" data-error role="alert" hidden></p>
  </form>

  <div class="done" data-success hidden>
    <span class="done__check" aria-hidden="true">✓</span>
    <div class="done__title">{beta.success.title}</div>
    <div class="done__body">{beta.success.body}</div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-signup]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-subscribe]");
    const success = root.querySelector<HTMLElement>("[data-success]");
    const errorBox = root.querySelector<HTMLElement>("[data-error]");
    const submitLabel = root.querySelector<HTMLElement>("[data-submit-label]");

    if (!form || !success || !errorBox || !submitLabel) return;

    const messages: Record<string, string> = JSON.parse(form.dataset.errors ?? "{}");
    const endpoint = form.dataset.endpoint ?? "/api/subscribe";
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const input = form.querySelector<HTMLInputElement>("input[name=email]")!;
    const trap = form.querySelector<HTMLInputElement>("input[name=company]")!;
    const idleLabel = submitLabel.textContent ?? "";

    const fail = (code: string) => {
      errorBox.textContent = messages[code] ?? messages.default ?? "Something went wrong.";
      errorBox.hidden = false;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorBox.hidden = true;

      if (!input.checkValidity()) {
        fail("invalid_email");
        input.focus();
        return;
      }

      button.disabled = true;
      submitLabel.textContent = "Sending…";

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ email: input.value, company: trap.value }),
        });

        const payload = (await response.json().catch(() => ({}))) as { error?: string };

        if (!response.ok) {
          fail(payload.error ?? "default");
          return;
        }

        form.hidden = true;
        success.hidden = false;
      } catch {
        fail("default");
      } finally {
        button.disabled = false;
        submitLabel.textContent = idleLabel;
      }
    });
  });
</script>

<style>
  .form__label {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    transition: border-color 0.2s;
  }

  .field:focus-within {
    border-color: var(--amber);
  }

  .field__icon {
    color: var(--text-faint);
    display: inline-flex;
    flex: none;
  }

  .field input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    color: var(--text-bright);
    font-size: 14.5px;
    font-family: var(--font-sans);
  }

  .field input::placeholder {
    color: var(--text-faint);
  }

  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__submit {
    margin-top: 11px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    background: var(--amber);
    border: none;
    border-radius: 10px;
    padding: 13px;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: background 0.2s;
  }

  .form__submit:hover:not(:disabled) {
    background: var(--amber-hi);
  }

  .form__submit:disabled {
    opacity: 0.65;
    cursor: progress;
  }

  .form__error {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--red);
    line-height: 1.5;
  }

  .done {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    padding: 14px 0;
  }

  .done__check {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(52, 211, 153, 0.14);
    border: 1px solid rgba(52, 211, 153, 0.5);
    color: var(--green);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }

  .done__title {
    font-size: 16px;
    font-weight: 600;
  }

  .done__body {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
