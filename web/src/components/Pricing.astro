---
import { pricing } from "../data";
---

<section class="pricing shell" id="pricing">
  <div class="pricing__head" data-reveal>
    <div class="eyebrow">{pricing.eyebrow}</div>
    <h2 class="pricing__title">{pricing.title}</h2>
    <p class="pricing__body">{pricing.body}</p>
  </div>

  <div class="tiers">
    {
      pricing.tiers.map((tier) => (
        <article
          class:list={["tier", tier.highlight && "tier--highlight"]}
          style={`--tier-accent:var(--${tier.accent})`}
          data-reveal
        >
          {tier.badge && <div class="tier__badge mono">{tier.badge}</div>}

          <h3 class="tier__name">{tier.name}</h3>
          <div class="tier__note">{tier.note}</div>

          <div class="tier__prices">
            <span class="tier__price">{tier.price}</span>
            <span class="tier__unit">{tier.priceNote}</span>
            {tier.strikePrice && <span class="tier__strike mono">{tier.strikePrice}</span>}
          </div>

          <ul class="tier__features">
            {tier.features.map((feature) => (
              <li class:list={["tier__feature", feature.muted && "is-muted"]}>
                <span class="tier__check" aria-hidden="true">
                  {feature.muted ? "·" : "✓"}
                </span>
                {feature.label}
              </li>
            ))}
          </ul>

          <a
            class:list={["tier__cta", tier.cta.variant === "ghost" && "tier__cta--ghost"]}
            href={tier.cta.href ?? pricing.checkoutFallbackHref}
          >
            {tier.cta.label}
          </a>

          <div class="tier__ctaNote mono">{tier.ctaNote}</div>
        </article>
      ))
    }
  </div>

  <div class="explainer" data-reveal>
    {
      pricing.explainer.map((cell) => (
        <div class="explainer__cell">
          <div class="explainer__label mono" style={`color:var(--${cell.accent ?? "muted"})`}>
            {cell.label}
          </div>
          <div class="explainer__body">{cell.body}</div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .pricing {
    padding-block: 56px 92px;
  }

  .pricing__head {
    text-align: center;
    margin-bottom: 44px;
  }

  .pricing__title {
    margin-top: 14px;
    font-size: clamp(26px, 3.6vw, 36px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .pricing__body {
    margin: 12px auto 0;
    font-size: 15.5px;
    color: var(--text-muted);
    max-width: 560px;
    line-height: 1.55;
  }

  /* Three tiers go 3-across or stack. auto-fit would pass through a 2-column
     step that leaves the third card orphaned beside a gap. */
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    max-width: 1080px;
    margin: 0 auto;
    align-items: stretch;
  }

  .tier {
    position: relative;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 32px 30px 30px;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .tier:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .tier--highlight {
    background: var(--surface);
    border: 1.5px solid var(--tier-accent);
    box-shadow: 0 30px 70px -30px color-mix(in srgb, var(--tier-accent) 50%, transparent);
  }

  .tier--highlight:hover {
    border-color: var(--tier-accent);
    box-shadow: 0 40px 80px -30px color-mix(in srgb, var(--tier-accent) 60%, transparent);
  }

  .tier__badge {
    position: absolute;
    top: -12px;
    left: 30px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--tier-accent);
    border-radius: 20px;
    padding: 5px 12px;
  }

  .tier__name {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .tier__note {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 5px;
  }

  .tier__prices {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 22px;
    flex-wrap: wrap;
  }

  .tier__price {
    font-size: 46px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .tier:not(.tier--highlight) .tier__price {
    color: var(--text-muted);
  }

  .tier__unit {
    font-size: 15px;
    color: var(--text-dim);
  }

  .tier__strike {
    font-size: 15px;
    color: var(--text-ghost);
    text-decoration: line-through;
  }

  /* The bottom margin keeps a minimum gap above the CTA in the tallest card,
     where the CTA's auto top margin resolves to zero. */
  .tier__features {
    display: flex;
    flex-direction: column;
    gap: 11px;
    margin: 24px 0 26px;
    padding: 0;
    list-style: none;
    font-size: 13.5px;
    color: var(--text-soft);
  }

  .tier:not(.tier--highlight) .tier__features {
    color: var(--text-muted);
  }

  .tier__feature {
    display: flex;
    gap: 10px;
  }

  .tier__feature.is-muted {
    color: var(--text-dim);
  }

  .tier__check {
    color: var(--tier-accent);
    flex: none;
  }

  .tier:not(.tier--highlight) .tier__check {
    color: var(--amber);
  }

  .tier__feature.is-muted .tier__check {
    color: var(--text-fainter);
  }

  .tier__cta {
    display: block;
    margin-top: auto;
    text-align: center;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    background: var(--tier-accent);
    border-radius: 9px;
    padding: 13px;
    transition: filter 0.2s;
  }

  .tier__cta:hover {
    filter: brightness(1.1);
    color: var(--ink);
  }

  .tier__cta--ghost {
    font-weight: 500;
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .tier__cta--ghost:hover {
    background: rgba(255, 255, 255, 0.11);
    filter: none;
    color: var(--text);
  }

  /* Reserve two lines so a wrapping note can't push its card's CTA out of
     alignment with the other tiers. */
  .tier__ctaNote {
    margin-top: 12px;
    min-height: 2.9em;
    min-height: 2lh;
    text-align: center;
    font-size: 11px;
    color: var(--text-ghost);
  }

  /* Same rule as the tiers: 3-up or stacked, never a 2+1 with a dead cell.
     The extra top margin clears the highlighted tiers' drop shadows. */
  .explainer {
    max-width: 1080px;
    margin: 52px auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    overflow: hidden;
  }

  .explainer__cell {
    background: rgba(255, 255, 255, 0.04);
    padding: 18px 20px;
  }

  .explainer__label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .explainer__body {
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-top: 8px;
  }

  /* Stacked cells keep their separators for free: the 1px gap becomes a row
     gap and the hairline container background shows through it. */
  @media (max-width: 940px) {
    .tiers,
    .explainer {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .pricing {
      padding-block: 32px 56px;
    }

    .explainer {
      margin-top: 36px;
    }
  }
</style>
