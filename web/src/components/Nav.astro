---
import { resolved, site } from "../data";
import Icon from "./Icon.astro";

const links = resolved(site.nav);
---

<header class="nav">
  <div class="nav__inner shell">
    <a class="brand" href="#top">
      <Icon name="hex" size={22} />
      <span class="brand__name">{site.brand.name}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((entry) => (
          <a
            href={entry.href}
            target={entry.external ? "_blank" : undefined}
            rel={entry.external ? "noreferrer" : undefined}
          >
            {entry.label}
            {entry.external && <span class="nav__ext">↗</span>}
          </a>
        ))
      }
    </nav>

    <a class="nav__cta" href={site.navCta.href ?? "/install"}>{site.navCta.label}</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    backdrop-filter: blur(10px);
    background: rgba(15, 17, 22, 0.8);
    border-bottom: 1px solid var(--hairline);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-block: 18px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--amber);
  }

  .brand__name {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .nav__links {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 14px;
  }

  .nav__links a {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--text-muted);
  }

  .nav__links a:hover {
    color: var(--text);
  }

  .nav__ext {
    font-size: 11px;
  }

  .nav__cta {
    margin-left: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
    background: var(--amber);
    border-radius: 8px;
    padding: 9px 16px;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .nav__cta:hover {
    background: var(--amber-hi);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .nav__links {
      display: none;
    }

    .nav__cta {
      margin-left: auto;
    }
  }
</style>
