---
/**
 * Renders a headline's authored line breaks, which only hold up while there is
 * room for them. Below the breakpoint the breaks collapse and the text wraps
 * to fit instead of overflowing the viewport.
 */
interface Props {
  lines: string[];
}

const { lines } = Astro.props;
---

{
  lines.map((line, index) => (
    <>
      {index > 0 && <br class="brk" />}
      {line}
      {index < lines.length - 1 ? " " : ""}
    </>
  ))
}

<style>
  @media (max-width: 720px) {
    .brk {
      display: none;
    }
  }
</style>
