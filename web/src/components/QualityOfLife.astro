---
import { qol } from "../data";
---

<section class="qol shell">
  <div class="qol__head" data-reveal>
    <div class="qol__lead">
      <div class="eyebrow">{qol.eyebrow}</div>
      <h2 class="qol__title">{qol.title}</h2>
    </div>
    <p class="qol__intro">{qol.intro}</p>
  </div>

  <div class="qol__grid" data-reveal>
    {
      qol.items.map((item) => (
        <div class="qol__cell">
          <div class="qol__cell-head">
            <span class="qol__glyph">{item.glyph}</span>
            <div class="qol__cell-title">{item.title}</div>
          </div>
          <p class="qol__cell-body">{item.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .qol {
    padding-block: 80px 24px;
  }

  .qol__head {
    display: flex;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .qol__lead {
    flex: 1;
    min-width: 280px;
  }

  .qol__title {
    margin-top: 18px;
    font-size: clamp(26px, 3.4vw, 34px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .qol__intro {
    flex: 1;
    min-width: 280px;
    font-size: 15px;
    color: var(--text-dim);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .qol__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
  }

  .qol__cell {
    background: #131519;
    padding: 26px 26px 28px;
  }

  .qol__cell-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .qol__glyph {
    color: var(--amber);
    font-size: 14px;
  }

  .qol__cell-title {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .qol__cell-body {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.65;
    text-wrap: pretty;
  }

  @media (max-width: 1040px) {
    .qol__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .qol {
      padding-block: 56px 16px;
    }

    .qol__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
