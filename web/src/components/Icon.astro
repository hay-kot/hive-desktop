---
/**
 * Icon set for the landing page. Everything inherits `currentColor` except the
 * Slack mark, which is multi-colour by brand.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;

const GITHUB_PATH =
  "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z";

const stroke = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
};
---

{
  name === "github" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 16 16"
      fill="currentColor"
      class={className}
      aria-hidden="true"
    >
      <path d={GITHUB_PATH} />
    </svg>
  )
}
{
  name === "slack" && (
    <svg width={size} height={size} viewBox="0 0 24 24" class={className} aria-hidden="true">
      <rect x="9" y="2" width="2.7" height="20" rx="1.35" fill="#36C5F0" />
      <rect x="12.3" y="2" width="2.7" height="20" rx="1.35" fill="#2EB67D" />
      <rect x="2" y="9" width="20" height="2.7" rx="1.35" fill="#ECB22E" />
      <rect x="2" y="12.3" width="20" height="2.7" rx="1.35" fill="#E01E5A" />
    </svg>
  )
}
{
  name === "grafana" && (
    <svg
