---
import { resolved, site } from "../data";
import Icon from "./Icon.astro";

const links = resolved(site.footerLinks);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner shell">
    <div class="footer__brand">
      <Icon name="hex" size={18} />
      <span class="footer__name">{site.brand.name}</span>
      <span class="footer__version mono">{site.version}</span>
    </div>

    <nav class="footer__links" aria-label="Footer">
      {
        links.map((entry) => (
          <a href={entry.href} class:list={[entry.accent && "is-accent"]}>
            {entry.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="footer__legal shell mono">© {year} {site.copyrightSuffix}</div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    background: rgba(255, 255, 255, 0.025);
  }

  .footer__inner {
    padding-block: 36px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--amber);
  }

  .footer__name {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .footer__version {
    font-size: 11.5px;
    color: var(--text-dim);
    margin-left: 6px;
  }

  .footer__links {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 13.5px;
    flex-wrap: wrap;
  }

  .footer__links a {
    color: var(--text-muted);
  }

  .footer__links a:hover {
    color: var(--text);
  }

  .footer__links a.is-accent {
    color: var(--amber);
    font-weight: 600;
  }

  .footer__links a.is-accent:hover {
    color: var(--amber-hi);
  }

  .footer__legal {
    padding-bottom: 32px;
    font-size: 11.5px;
    color: var(--text-fainter);
  }

  @media (max-width: 640px) {
    .footer__links {
      margin-left: 0;
      gap: 18px;
    }
  }
</style>
