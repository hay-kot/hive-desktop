---
import { beta } from "../data";
import Lines from "./Lines.astro";
import SignupForm from "./SignupForm.astro";
---

<section class="beta shell" id="beta">
  <div class="beta__card" data-reveal>
    <div class="beta__glow" aria-hidden="true"></div>

    <div class="beta__grid">
      <div>
        <div class="beta__status mono">
          <span class="beta__dot"></span>{beta.status}
        </div>

        <h2 class="beta__title"><Lines lines={beta.titleLines} /></h2>

        <p class="beta__body">{beta.body}</p>

        <div class="beta__perks">
          {
            beta.perks.map((perk) => (
              <span class="pill">
                <span style={`color:var(--${perk.accent})`}>{perk.icon}</span>
                {perk.label}
              </span>
            ))
          }
        </div>
      </div>

      <div class="panel">
        <SignupForm />
      </div>
    </div>
  </div>
</section>

<style>
  .beta {
    padding-block: 44px 72px;
  }

  .beta__card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #23252e 0%, #1b1d24 55%, #201d16 100%);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 22px;
    padding: 48px 44px;
    box-shadow: 0 40px 90px -40px rgba(245, 158, 11, 0.35);
  }

  .beta__glow {
    position: absolute;
    top: -40%;
    right: -8%;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle at center, rgba(245, 158, 11, 0.28), transparent 66%);
    filter: blur(20px);
    pointer-events: none;
    animation: hiveGlow 7s ease-in-out infinite;
  }

  .beta__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 40px;
    align-items: center;
  }

  .beta__status {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber);
  }

  .beta__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
    animation: hivePulse 2s ease-in-out infinite;
  }

  .beta__title {
    margin-top: 16px;
    font-size: clamp(26px, 3.4vw, 34px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .beta__body {
    margin-top: 14px;
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 440px;
    text-wrap: pretty;
  }

  .beta__perks {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 22px;
  }

  .panel {
    background: rgba(13, 14, 17, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 26px;
    backdrop-filter: blur(4px);
  }

  @media (max-width: 720px) {
    .beta {
      padding-block: 24px 48px;
    }

    .beta__card {
      padding: 32px 22px;
    }
  }
</style>
