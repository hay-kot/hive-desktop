---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Keep a page out of search indexes — used for unlisted, invite-only pages. */
  noindex?: boolean;
  /** The animated gradient/grid backdrop. Off for long-form reading (docs). */
  backdrop?: boolean;
}

const { title, description, noindex = false, backdrop = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f1116" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    {
      backdrop && (
        <div class="backdrop" aria-hidden="true">
          <div class="blob blob--a" />
          <div class="blob blob--b" />
          <div class="blob blob--c" />
          <div class="grid" />
        </div>
      )
    }

    <div class="page">
      <slot />
    </div>

    <script>
      // Sections start visible (see global.css) so the page reads without JS.
      // Only once this runs do we arm them for the scroll reveal.
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");

      if (!reduce && targets.length && "IntersectionObserver" in window) {
        targets.forEach((el) => el.classList.add("is-armed"));

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-shown");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        );

        targets.forEach((el) => observer.observe(el));

        // A missed observer callback would otherwise leave a section invisible
        // for good. Degrade to "shown without the animation" instead.
        setTimeout(() => {
          targets.forEach((el) => el.classList.add("is-shown"));
          observer.disconnect();
        }, 5000);
      }
    </script>
  </body>
</html>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
  }

  .blob--a {
    top: -18%;
    left: -12%;
    width: 60vw;
    height: 60vw;
    max-width: 820px;
    max-height: 820px;
    background: radial-gradient(circle at center, rgba(245, 158, 11, 0.2), transparent 62%);
    filter: blur(20px);
    animation: bgFloatA 24s ease-in-out infinite;
  }

  .blob--b {
    bottom: -22%;
    right: -14%;
    width: 56vw;
    height: 56vw;
    max-width: 780px;
    max-height: 780px;
    background: radial-gradient(circle at center, rgba(96, 165, 250, 0.15), transparent 62%);
    filter: blur(30px);
    animation: bgFloatB 30s ease-in-out infinite;
  }

  .blob--c {
    top: 32%;
    right: 22%;
    width: 38vw;
    height: 38vw;
    max-width: 520px;
    max-height: 520px;
    background: radial-gradient(circle at center, rgba(167, 139, 250, 0.13), transparent 62%);
    filter: blur(30px);
    animation: bgFloatC 27s ease-in-out infinite;
  }

  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 70px 70px;
    animation: gridPan 32s linear infinite;
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 20%, #000 40%, transparent 85%);
    mask-image: radial-gradient(ellipse 90% 70% at 50% 20%, #000 40%, transparent 85%);
  }

  .page {
    position: relative;
    z-index: 1;
  }
</style>
