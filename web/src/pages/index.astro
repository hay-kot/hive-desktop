---
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.astro";
import Onboarding from "../components/Onboarding.astro";
import Pipeline from "../components/Pipeline.astro";
import QualityOfLife from "../components/QualityOfLife.astro";
import Surfaces from "../components/Surfaces.astro";
import { site } from "../data";
import Base from "../layouts/Base.astro";
---

<Base title={`${site.brand.name} · ${site.brand.tagline}`} description={site.description}>
  <Nav />
  <main>
    <Hero />
    <Pipeline />
    <Features />
    <QualityOfLife />
    <Onboarding />
    <Surfaces />
  </main>
  <Footer />
</Base>
