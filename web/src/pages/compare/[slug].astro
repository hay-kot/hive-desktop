---
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import SignupDialog from "../../components/SignupDialog.astro";
import { comparisons } from "../../data/compare";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return comparisons.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const versus = entry.complement ? "with" : "vs";
const heading = `Hive ${versus} ${entry.them.name}`;

/** Cell glyphs. `partial` and `n/a` are distinct on purpose: one is a weaker
 * yes, the other says the row does not apply to what that product is for. */
const marks = { yes: "●", partial: "◐", no: "○", "n/a": "–" } as const;
---

<Base title={`${heading} · Hive`} description={entry.description}>
  <Nav />
  <main class="shell page">
    <header class="page__head">
      <a class="page__back mono" href="/compare">← All comparisons</a>
      <h1 class="page__title">{heading}</h1>
      <p class="page__thesis">{entry.thesis}</p>
    </header>

    <!-- Their column first: the reader's guard drops in the first ten seconds
         or not at all. -->
    <section class="verdict">
      <div class="verdict__col">
        <h2 class="verdict__title">Choose {entry.them.name} if</h2>
        <ul>{entry.verdict.chooseThem.map((line) => <li>{line}</li>)}</ul>
      </div>
      <div class="verdict__col verdict__col--us">
        <h2 class="verdict__title">Choose Hive if</h2>
        <ul>{entry.verdict.chooseUs.map((line) => <li>{line}</li>)}</ul>
      </div>
    </section>

    <section class="prose">
      <h2>What {entry.them.name} is</h2>
      {entry.them.quote && <blockquote class="quote">“{entry.them.quote}”</blockquote>}
      <p>{entry.them.summary}</p>
      <p class="prose__link mono">
        <a href={entry.them.url} target="_blank" rel="noreferrer nofollow">{entry.them.url} ↗</a>
      </p>

      <h2>What Hive is</h2>
      <p>{entry.us}</p>

      <h2>{entry.difference.title}</h2>
      {entry.difference.body.map((para) => <p>{para}</p>)}
    </section>

    <section class="claims">
      <div class="claims__col">
        <h2 class="claims__title">Where {entry.them.name} is better</h2>
        {
          entry.theirWins.map((win) => (
            <div class="claim">
              <h3 class="claim__title">{win.title}</h3>
              <p class="claim__body">{win.body}</p>
            </div>
          ))
        }
      </div>
      <div class="claims__col">
        <h2 class="claims__title">Where Hive is better</h2>
        {
          entry.ourWins.map((win) => (
            <div class="claim">
              <h3 class="claim__title">{win.title}</h3>
              <p class="claim__body">{win.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="table-wrap">
      <h2 class="prose__h2">Side by side</h2>
      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">&nbsp;</th>
              <th scope="col">{entry.them.name}</th>
              <th scope="col">Hive</th>
            </tr>
          </thead>
          <tbody>
            {
              entry.rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {[row.them, row.us].map((cellData) => (
                    <td>
                      <span class:list={["mark", `mark--${cellData.value}`]}>
                        {marks[cellData.value]}
                      </span>
                      {cellData.note && <span class="cell__note">{cellData.note}</span>}
                      {cellData.source && (
                        <a
                          class="cell__src mono"
                          href={cellData.source}
                          target="_blank"
                          rel="noreferrer nofollow"
                        >
                          source
                        </a>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {
      entry.both && (
        <section class="both">
          <h2 class="both__title">{entry.both.title}</h2>
          <p class="both__body">{entry.both.body}</p>
        </section>
      )
    }

    <section class="prose">
      <p class="closing">{entry.closing}</p>
    </section>

    <footer class="verified mono">
      Last checked {entry.verifiedAt} against {entry.theirVersion}. Products move; if something
      here is out of date, tell us and we will fix it.
    </footer>
  </main>
  <Footer />
  <SignupDialog />
</Base>

<style>
  .page {
    padding-block: 56px 40px;
    max-width: 900px;
  }

  .page__back {
    font-size: 12px;
    color: var(--text-dim);
    text-decoration: none;
  }

  .page__title {
    margin-top: 16px;
    font-size: clamp(30px, 4.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .page__thesis {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 660px;
    text-wrap: pretty;
  }

  .verdict {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 40px;
  }

  @media (max-width: 760px) {
    .verdict,
    .claims {
      grid-template-columns: 1fr;
    }
  }

  .verdict__col {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px;
  }

  .verdict__col--us {
    border-color: var(--amber-edge);
    background: var(--amber-tint);
  }

  .verdict__title {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .verdict__col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .verdict__col li {
    position: relative;
    padding-left: 16px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .verdict__col li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--line-2);
  }

  .prose {
    margin-top: 48px;
    max-width: 720px;
  }

  .prose :global(h2),
  .prose__h2 {
    font-size: clamp(19px, 2.4vw, 24px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .prose :global(p + p) {
    margin-top: 13px;
  }

  .quote {
    border-left: 2px solid var(--amber-edge);
    padding-left: 14px;
    margin-bottom: 13px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text);
    font-style: italic;
  }

  .prose__link a {
    font-size: 12px;
    color: var(--text-dim);
  }

  .claims {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 52px;
  }

  .claims__title {
    font-size: clamp(19px, 2.4vw, 24px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .claim + .claim {
    margin-top: 18px;
  }

  .claim__title {
    font-size: 14.5px;
    font-weight: 600;
    margin-bottom: 5px;
  }

  .claim__body {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .table-wrap {
    margin-top: 52px;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }

  .table th,
  .table td {
    text-align: left;
    padding: 11px 14px;
    border-bottom: 1px solid var(--line-3);
    font-size: 13px;
    vertical-align: top;
  }

  .table thead th {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-ghost);
  }

  .table tbody th {
    font-weight: 500;
    color: var(--text);
    width: 42%;
  }

  .table td {
    color: var(--text-muted);
  }

  .mark {
    display: inline-block;
    margin-right: 7px;
    font-size: 12px;
  }

  .mark--yes {
    color: var(--green);
  }

  .mark--partial {
    color: var(--amber);
  }

  .mark--no,
  .mark--n\/a {
    color: var(--text-ghost);
  }

  .cell__note {
    font-size: 12px;
  }

  .cell__src {
    display: inline-block;
    margin-left: 7px;
    font-size: 10px;
    color: var(--text-ghost);
  }

  .both {
    margin-top: 52px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 26px;
    max-width: 720px;
  }

  .both__title {
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 9px;
  }

  .both__body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .closing {
    font-size: 15px !important;
    color: var(--text) !important;
  }

  .verified {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--line-3);
    font-size: 11px;
    color: var(--text-ghost);
    line-height: 1.6;
  }
</style>
