---
/**
 * Unlisted invite-only install page. The path is a random token so the page is
 * unguessable; it is `noindex` and disallowed in robots.txt as well. The
 * installer it documents is the static asset alongside it, under the same token
 * (web/public/install/<token>/install.sh) — so robots.txt disallows the whole
 * /install/ prefix without ever printing the token. Rotating the URL means
 * renaming both this file and that directory to a new token.
 */
import Icon from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";

const version = "v0.4 beta";
const command =
  "curl -fsSL https://hivedesktop.com/install/a1c6d523f7a3d06eed1e7b43/install.sh | bash";

const mac = { arches: "Apple silicon · Intel", path: "/Applications/Hive.app" };

const steps = [
  {
    title: "Run the installer",
    body: "Paste the command above. It pulls the latest beta build for your machine and puts <code>hive</code> on your PATH.",
  },
  {
    title: "Connect GitHub",
    body: "Launch Hive and sign in. It reads your issues, PRs and review requests through your own GitHub account.",
  },
  {
    title: "Build your first feed",
    body: "Add a source, drop a filter on it, point it at a feed. Or paste our prompt into your agent and let it write the config.",
  },
];

const goodToKnow = [
  { title: "Updating", body: "hive update, or re-run the install command" },
  { title: "Beta / dev builds", body: "… | bash -s -- --channel dev" },
  { title: "Uninstall", body: "hive uninstall removes the binary and config" },
  { title: "Read it first", body: "Drop the | bash to inspect the script" },
];
---

<Base
  title="Install Hive"
  description="Private-beta install link for the Hive desktop app."
  noindex
>
  <div class="install">
    <header class="topbar">
      <a class="topbar__brand" href="/">
        <Icon name="hex" size={22} />
        <span>Hive</span>
      </a>
      <span class="badge">Private beta</span>
      <span class="topbar__spacer"></span>
      <span class="topbar__version mono">{version}</span>
    </header>

    <div class="install__body">
      <div class="tag-pill mono">
        <span class="tag-pill__dot"></span>Invite-only link
      </div>

      <h1 class="install__title">Install Hive</h1>
      <p class="install__lead">
        One command pulls the right binary for your machine from the latest beta build. This URL is
        unlisted, so please don’t share it outside the beta.
      </p>

      <div class="tabs" role="tablist" aria-label="Operating system">
        <button class="tab is-active" data-os="mac" type="button" aria-selected="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M16.4 12.7c0-2.4 2-3.6 2.1-3.6-1.1-1.7-2.9-1.9-3.6-1.9-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.5 1.3-.1 1.8-.8 3.3-.8 1.5 0 2 .8 3.3.8 1.4 0 2.2-1.2 3.1-2.5.7-1 1.2-2 1.4-2.6-.1 0-2.8-1.1-2.8-4.6zM14 5.4c.7-.9 1.2-2.1 1-3.4-1 .1-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.2 1.2.1 2.4-.6 3.1-1.4z"
            ></path></svg
          >macOS
        </button>
        <button class="tab" data-os="linux" type="button" aria-selected="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
            ><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"
            ></path></svg
          >Linux
          <span class="tab__soon mono">Soon</span>
        </button>
        <button class="tab" data-os="win" type="button" aria-selected="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path d="M3 5.5l7.5-1v7H3zM11.5 4.3L21 3v8.5h-9.5zM3 12.5h7.5v7L3 18.5zM11.5 12.5H21V21l-9.5-1.3z"
            ></path></svg
          >Windows
          <span class="tab__soon mono">Soon</span>
        </button>
      </div>

      <div class="cmd" data-panel="mac">
        <div class="cmd__head">
          <span class="cmd__dot"></span>
          <span class="cmd__label mono">macOS · one-line install</span>
          <span class="cmd__spacer"></span>
          <span class="cmd__arches mono">{mac.arches}</span>
        </div>
        <div class="cmd__body">
          <span class="cmd__prompt mono">$</span>
          <code class="cmd__code mono" data-command>{command}</code>
          <button class="cmd__copy mono" type="button" data-copy={command}>Copy</button>
        </div>
        <div class="cmd__foot mono">
          Detects your arch, verifies the checksum, installs to
          <span class="cmd__hi">{mac.path}</span>, and symlinks
          <span class="cmd__hi">hive</span> onto your PATH.
        </div>
      </div>

      <div class="soon" data-panel="linux" hidden>
        <span class="soon__icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
            ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg
          >
        </span>
        <div>
          <div class="soon__title">Linux builds are coming</div>
          <div class="soon__body">
            The release pipeline ships macOS during the beta; Linux x86_64 and arm64 are next in
            line. Beta members get an email the moment builds land.
          </div>
        </div>
      </div>

      <div class="soon" data-panel="win" hidden>
        <span class="soon__icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
            ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg
          >
        </span>
        <div>
          <div class="soon__title">Windows builds are coming</div>
          <div class="soon__body">
            The release pipeline ships macOS during the beta, with Linux next in line. Windows
            lands after the pipeline is stable.
          </div>
        </div>
      </div>

      <div class="steps">
        {
          steps.map((step, i) => (
            <div class="step">
              <div class="step__num mono">{String(i + 1).padStart(2, "0")}</div>
              <div class="step__title">{step.title}</div>
              <div class="step__body" set:html={step.body} />
            </div>
          ))
        }
      </div>

      <div class="gtk">
        <div class="gtk__head mono">Good to know</div>
        <div class="gtk__grid">
          {
            goodToKnow.map((item) => (
              <div class="gtk__cell">
                <div class="gtk__title">{item.title}</div>
                <div class="gtk__body mono">{item.body}</div>
              </div>
            ))
          }
        </div>
      </div>

      <p class="help">
        <span class="help__mark">ⓘ</span>Hit a snag? Reply to your invite email or ping the beta
        Discord. Builds ship weekly and rough edges are expected.
      </p>
    </div>
  </div>
</Base>

<script>
  // Invite links may carry ?channel=beta|dev. The installer script is static and
  // identical for every channel; only the command shown here gains the flag that
  // picks the channel at run time.
  const channel = new URLSearchParams(location.search).get("channel");
  if (channel === "beta" || channel === "dev") {
    const code = document.querySelector<HTMLElement>("[data-command]");
    const copy = document.querySelector<HTMLButtonElement>("[data-copy]");
    const base = copy?.dataset.copy ?? code?.textContent ?? "";
    const flagged = `${base} -s -- --channel ${channel}`;
    if (code) code.textContent = flagged;
    if (copy) copy.dataset.copy = flagged;
  }

  const tabs = document.querySelectorAll<HTMLButtonElement>(".tab");
  const panels = document.querySelectorAll<HTMLElement>("[data-panel]");

  function select(os: string) {
    tabs.forEach((tab) => {
      const active = tab.dataset.os === os;
      tab.classList.toggle("is-active", active);
      tab.setAttribute("aria-selected", String(active));
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.panel !== os;
    });
  }

  tabs.forEach((tab) => tab.addEventListener("click", () => select(tab.dataset.os ?? "mac")));

  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy]");
  if (copyBtn) {
    let reset: ReturnType<typeof setTimeout>;
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.copy ?? "");
      } catch {
        return;
      }
      copyBtn.textContent = "Copied";
      copyBtn.classList.add("is-copied");
      clearTimeout(reset);
      reset = setTimeout(() => {
        copyBtn.textContent = "Copy";
        copyBtn.classList.remove("is-copied");
      }, 1800);
    });
  }
</script>

<style>
  .install {
    max-width: 900px;
    margin: 0 auto;
  }

  .topbar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    border-bottom: 1px solid var(--hairline);
  }

  .topbar__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--amber);
  }

  .topbar__brand span {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .topbar__spacer {
    flex: 1;
  }

  .topbar__version {
    font-size: 11.5px;
    color: var(--text-dim);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber);
    background: rgba(245, 158, 11, 0.14);
    border: 1px solid var(--amber-edge);
    border-radius: 20px;
    padding: 3px 10px;
  }

  .install__body {
    padding: 64px 32px 96px;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 6px 13px;
  }

  .tag-pill__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    animation: hivePulse 2.4s ease-in-out infinite;
  }

  .install__title {
    margin-top: 22px;
    font-size: clamp(34px, 5vw, 46px);
    line-height: 1.06;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .install__lead {
    margin-top: 16px;
    font-size: clamp(15.5px, 1.6vw, 17px);
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 600px;
    text-wrap: pretty;
  }

  .tabs {
    display: flex;
    gap: 8px;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 500;
    padding: 10px 16px;
    border-radius: 9px;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .tab.is-active {
    background: rgba(245, 158, 11, 0.14);
    border-color: rgba(245, 158, 11, 0.45);
    color: var(--amber-hi);
  }

  .tab__soon {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 5px;
    padding: 1px 5px;
  }

  .cmd {
    margin-top: 18px;
    background: var(--panel-2);
    border: 1px solid var(--line-diagram);
    border-radius: 14px;
    overflow: hidden;
  }

  .cmd__head {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 16px;
    background: var(--surface);
    border-bottom: 1px solid var(--line-diagram);
  }

  .cmd__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--amber);
  }

  .cmd__label {
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .cmd__spacer {
    flex: 1;
  }

  .cmd__arches {
    font-size: 11px;
    color: var(--text-ghost);
  }

  .cmd__body {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 20px 18px 20px 20px;
  }

  .cmd__prompt {
    font-size: 14px;
    color: var(--text-fainter);
    line-height: 1.6;
    flex: none;
  }

  .cmd__code {
    flex: 1;
    min-width: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-diagram);
    word-break: break-all;
  }

  .cmd__copy {
    flex: none;
    padding: 7px 13px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--text-soft);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .cmd__copy.is-copied {
    border-color: rgba(52, 211, 153, 0.5);
    background: rgba(52, 211, 153, 0.14);
    color: var(--green);
  }

  .cmd__foot {
    border-top: 1px solid var(--line-diagram);
    padding: 13px 20px;
    font-size: 11.5px;
    color: #7c828d;
    line-height: 1.6;
  }

  .cmd__hi {
    color: #c8cdd6;
  }

  .soon {
    margin-top: 18px;
    background: var(--panel-2);
    border: 1px dashed #3a3f4a;
    border-radius: 14px;
    padding: 28px 24px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .soon__icon {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--surface);
    border: 1px solid var(--line-diagram);
    color: var(--text-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .soon__title {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .soon__body {
    margin-top: 7px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 520px;
    text-wrap: pretty;
  }

  .steps {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .step {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 20px 22px;
  }

  .step__num {
    font-size: 12px;
    font-weight: 600;
    color: var(--amber);
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 9px;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step__title {
    margin-top: 14px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .step__body {
    margin-top: 6px;
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .step__body :global(code) {
    font-family: var(--font-mono);
    color: var(--text-diagram);
  }

  .gtk {
    margin-top: 40px;
    background: var(--panel-2);
    border: 1px solid var(--line-diagram);
    border-radius: 14px;
    overflow: hidden;
  }

  .gtk__head {
    padding: 15px 20px;
    border-bottom: 1px solid var(--line-diagram);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .gtk__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-diagram);
  }

  .gtk__cell {
    background: var(--panel-2);
    padding: 18px 20px;
  }

  .gtk__title {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-diagram);
  }

  .gtk__body {
    margin-top: 6px;
    font-size: 12px;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .help {
    margin-top: 36px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: var(--text-dim);
    line-height: 1.55;
  }

  .help__mark {
    color: var(--amber);
  }

  @media (max-width: 720px) {
    .topbar {
      padding: 16px 22px;
    }

    .install__body {
      padding: 44px 22px 72px;
    }

    .cmd__body {
      flex-wrap: wrap;
    }

    .cmd__copy {
      width: 100%;
      margin-top: 4px;
      padding: 11px 13px;
    }

    .gtk__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
